#global
DOMAIN=<domain>

# Mongo configuration
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo

# Next configuration
SALT=SALT123
DEFAULT_USER_EMAIL=admin@admin.com
DEFAULT_USER_PASSWORD=admin123
MONGO_CONNECTION_STRING=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo:27017

# nginx configuration
PATH_2_FULLCHAIN=/cert/archive/${DOMAIN}/fullchain1.pem
PATH_2_PRIVATEKEY=/cert/archive/${DOMAIN}/privkey1.pem