{
  "name": "next-dlrg-swim",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "1.0.0",
  "homepage": "https://github.com/no4any/next-dlrg-swim#readme",
  "bugs": {
    "url": "https://github.com/no4any/next-dlrg-swim/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no4any/next-dlrg-swim.git"
  },
  "license": "MIT",
  "scripts": {
    "setup":"npm run gen:keys && cp default.env .env",
    "build": "npm run build --workspace=@next-dlrg-swim/next",
    "start": "npm run start --workspace=@next-dlrg-swim/next",
    "dev": "npm run dev --workspace=@next-dlrg-swim/next",
    "dev:docker": "docker compose -f docker-compose.dev.yml up",
    "gen:keys": "node keygen.js",
    "prod": "docker compose up -d",
    "prod:stop": "docker compose stop",
    "prod:log": "docker compose logs -f"
  }
}
